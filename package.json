{
  "name": "metaplex-algo-memecoin-agent-poc",
  "version": "1.0.0",
  "description": "AI agent that mints memecoins on Solana mainnet via Metaplex Token Metadata + Arweave",
  "type": "module",
  "scripts": {
    "scan": "node src/agent/trend-scanner.js",
    "mint": "node src/mint/mint-token.js",
    "mint-all": "node src/agent/mint-all.js",
    "auto": "node src/agent/trend-scanner.js && node src/agent/mint-all.js",
    "check": "node src/wallet/check-balance.js"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "1.5.1",
    "@metaplex-foundation/umi-uploader-irys": "1.5.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bip39": "^3.1.0",
    "bs58": "6.0.0",
    "dotenv": "16.6.1",
    "ed25519-hd-key": "^2.0.0",
    "openai": "^6.36.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
